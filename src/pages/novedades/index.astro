---
import Base from '../../layouts/Base.astro';
import Entrada from '../../components/Entrada.astro';
import { entradasPublicadas } from '../../lib/entradas';
const entradas = await entradasPublicadas();
const tipos = [...new Set(entradas.map(e => e.data.tipo))];
---
<Base title="Novedades — revisiones de nota, noticias y recortes · DividendoSeguro" activo="novedades"
  description="Todas las revisiones y confirmaciones de nota, noticias de dividendos y recortes de las empresas que seguimos.">
  <div class="wrap" style="max-width:860px">
    <h1 style="margin-top:36px">Novedades</h1>
    <p class="muted">Cada vez que revisamos o confirmamos una nota, o pasa algo relevante para el dividendo, lo contamos aquí. <a href="/rss.xml">RSS</a></p>
    <div class="tools">
      <select id="ft" aria-label="Tipo"><option value="">Todo</option>{tipos.map(t => <option>{t}</option>)}</select>
    </div>
    <div class="grid" id="lista">
      {entradas.map(e => <div data-tipo={e.data.tipo}><Entrada entrada={e} /></div>)}
    </div>
    {entradas.length === 0 && <p class="muted">Todavía no hay entradas.</p>}
  </div>
  <script>
    const ft = document.getElementById('ft') as HTMLSelectElement;
    ft.addEventListener('input', () => document.querySelectorAll<HTMLElement>('#lista > div').forEach(d => { d.hidden = !!ft.value && d.dataset.tipo !== ft.value; }));
  </script>
</Base>
