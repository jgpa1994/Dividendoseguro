---
import { COLOR } from '../lib/fmt';
interface Props { nota: number; lectura: string; size?: number }
const { nota, lectura, size = 240 } = Astro.props;
// semicírculo de 180º: tramos 0-49 / 49-60 / 60-80 / 80-100
const R = 80, CX = 100, CY = 95;
const pt = (v: number) => {
  const a = Math.PI * (1 - v / 100);
  return [CX + R * Math.cos(a), CY - R * Math.sin(a)];
};
const arc = (a: number, b: number) => {
  const [x1, y1] = pt(a), [x2, y2] = pt(b);
  return `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${R} ${R} 0 0 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};
const tramos = [[0, 49, '#f3d9cc'], [49, 60, '#f6e6c2'], [60, 80, '#cfdcf4'], [80, 100, '#c9e9d6']] as const;
const [nx, ny] = pt(nota);
const color = COLOR[lectura];
---
<svg viewBox="0 0 200 120" width={size} role="img" aria-label={`Nota ${nota} de 100: ${lectura}`}>
  {tramos.map(([a, b, c]) => <path d={arc(a + 0.6, b - 0.6)} stroke={c} stroke-width="16" fill="none" />)}
  <path d={arc(0, Math.max(nota, 0.5))} stroke={color} stroke-width="16" fill="none" stroke-linecap="butt" />
  <circle cx={nx} cy={ny} r="9" fill="#fff" stroke={color} stroke-width="4" />
  <text x="100" y="88" text-anchor="middle" font-size="38" font-weight="800" fill={color} font-family="Manrope, sans-serif">{nota}</text>
  <text x="100" y="112" text-anchor="middle" font-size="13" font-weight="700" fill={color} font-family="Manrope, sans-serif">{lectura.toUpperCase()}</text>
</svg>
